{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "app/api/blog/route.ts": {
      "maxDuration": 10
    },
    "app/api/blog/[slug]/route.ts": {
      "maxDuration": 10
    }
  }
}