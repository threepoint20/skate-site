# 環境變數範例檔案
# 複製此檔案為 .env.local 並填入實際值

# 管理員帳號設定
ADMIN_USERNAME=admin
# 重要：bcrypt 雜湊中的 $ 符號必須用 \$ 轉義
# 例如：\$2b\$12\$xxxxx...
# 使用 node scripts/hash-password.js <密碼> 來生成雜湊值
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# JWT 安全設定
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# 網站設定
NEXT_PUBLIC_SITE_NAME=SkateInfo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 安全設定
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Neon PostgreSQL 資料庫 (優先使用)
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Vercel KV 資料庫 (備用選項，生產環境自動設定)
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token

# Vercel Blob 儲存 (圖片上傳，生產環境自動設定)
# BLOB_READ_WRITE_TOKEN=your_blob_token_here

# 生產環境範例
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app