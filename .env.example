# 環境變數範例檔案
# 複製此檔案為 .env.local 並填入實際值

# 管理員帳號設定
ADMIN_USERNAME=admin
# 重要：bcrypt 雜湊中的 $ 符號必須用 \$ 轉義
# 例如：\$2b\$12\$xxxxx...
# 使用 node scripts/hash-password.js <密碼> 來生成雜湊值
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# JWT 安全設定
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# 網站設定
NEXT_PUBLIC_SITE_NAME=SkateInfo
# 網站正式網址（robots.txt、sitemap.xml、結構化資料、Open Graph 都會使用）
# 正式環境請設為實際網域，例如 https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 安全設定
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Neon PostgreSQL 資料庫 (優先使用)
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Vercel KV 資料庫 (備用選項，生產環境自動設定)
# KV_REST_API_URL=your_kv_rest_api_url
# KV_REST_API_TOKEN=your_kv_rest_api_token

# Vercel Blob 儲存 (圖片上傳，生產環境自動設定)
# BLOB_READ_WRITE_TOKEN=your_blob_token_here

# ===== NAS / 自架部署 =====
# 圖片儲存方式：local（寫入容器內 public/images/blog，記得掛載 volume）
# 或 blob（Vercel Blob）。未設定時自動偵測：有 BLOB_READ_WRITE_TOKEN 就用 blob
# STORAGE_DRIVER=local

# 登入 cookie 的 Secure 旗標。production 預設 true；
# 若以純 HTTP 提供服務（例如 http://NAS_IP:3000）必須設為 false 才能登入，
# 有 HTTPS（反向代理 + 憑證）時請設 true 或不設
# COOKIE_SECURE=false

# 除錯 API（/api/debug/*）：production 預設關閉，診斷時可暫時開啟
# ENABLE_DEBUG_API=true

# 生產環境範例
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app